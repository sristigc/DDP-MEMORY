:80 {
	basic_auth /* {
		{$AUTH_USER} {$AUTH_PASS_HASH}
	}

	# DDP Galaxy (3D live graph). flush_interval -1 keeps the SSE live feed streaming.
	handle /galaxy* {
		reverse_proxy {$GALAXY_URL:http://galaxy.railway.internal:8080} {
			flush_interval -1
		}
	}

	# DDP-AGENT jobs API (list jobs, resume after the local log check).
	handle /agent/* {
		reverse_proxy {$RUNNER_URL:http://agent-runner.railway.internal:8080}
	}

	handle {
		reverse_proxy {$UPSTREAM_URL} {
			# The viewer only accepts Host headers it trusts (loopback on its own port),
			# otherwise it answers 403 "forbidden host". Rewrite to that value.
			header_up Host {$VIEWER_HOST_HEADER:localhost:8082}
		}
	}
}
